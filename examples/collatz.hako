// collatz.hako — sequência de Collatz (loop em block mode)
box collatz {
    N = 27
    COM1 = 0x3F8
    write_str(s) => default
    run {
        let mut n = N
        let mut steps = 0
        loop {
            if n == 1 { break }
            if n % 2 == 0 { n = n / 2 } else { n = 3 * n + 1 }
            steps = steps + 1
        }
        write_str("done")
    }
}

flow default {
    collatz
}
