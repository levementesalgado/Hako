// collatz.hako — Sequência de Collatz (sintaxe atual)
box collatz {
    MAX_N = 10000
    WIDTH = 16
    next(n) {
        if n % 2 == 0 { n / 2 } else { 3 * n + 1 }
    }
    stopping_time(n) {
        mut steps = 0
        mut x = n
        loop {
            if x == 1 { break }
            x = next(x)
            steps = steps + 1
        }
        steps
    }
}

flow default {
    collatz
}
