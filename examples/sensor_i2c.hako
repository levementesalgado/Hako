// Sensor I2C (BMP280-like)
box sensor {
    SDA = 2
    SCL = 3
    i2c_init(sda, scl) => default
    i2c_start(sda, scl) => default
    i2c_stop(sda, scl) => default
    i2c_write_byte(sda, scl, byte) => default
    init {
        i2c_init(SDA, SCL)
        i2c_start(SDA, SCL)
        i2c_write_byte(SDA, SCL, 0xEC)
        i2c_stop(SDA, SCL)
    }
    run {
        init()
    }
}

flow default {
    sensor
}
